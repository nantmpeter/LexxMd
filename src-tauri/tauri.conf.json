{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexx",
  "version": "0.1.0",
  "identifier": "com.lexx.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "Lexx",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["md", "markdown", "mdx"], "name": "Markdown", "role": "Editor" }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMzIyQ0M4NUVBNDc2NzUKUldSMWRxUmV5Q3d5YS9nZWVLc2V0MENORVlLUzdSN29QSGpMdEFOc0xhc1lodCtickhYRU45aXoK",
      "endpoints": [
        "https://nantmpeter.github.io/LexxMd/update/latest.json"
      ]
    }
  }
}
